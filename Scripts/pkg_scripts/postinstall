#!/bin/bash
# 速下安装器 postinstall（以 root 运行）
# 1) 从固定路径把 App 装到 /Applications（绕开 PackageKit 的 bundle 升级/重定位逻辑）
# 2) 退出旧版  3) 以登录用户注册浏览器扩展
set -uo pipefail

APP="/Applications/QuickDown.app"
SRC="/tmp/QuickDown-install/QuickDown.app"

# 1. 安装 App：payload 被 pkgbuild 放到确定的 /tmp/QuickDown-install，这里负责复制到 /Applications
if [ -d "$SRC" ]; then
  echo "==> 安装 App 到 /Applications"
  rm -rf "$APP"
  ditto "$SRC" "$APP"
  rm -rf "/tmp/QuickDown-install"
else
  echo "⚠️  未找到安装内容 $SRC，跳过 App 安装"
fi

# 完整性校验：必须有 CRX 与可读的 Info.plist
if [ -d "$APP" ]; then
  chmod -R a+rX "$APP"
  if [ ! -f "$APP/Contents/Resources/BrowserExtension.crx" ]; then
    echo "⚠️  App 不完整（缺少 BrowserExtension.crx）"
  fi
fi

# 2. 退出旧版应用
pkill -x QuickDown 2>/dev/null || true
sleep 1

# 3. 找到控制台登录用户并注册浏览器扩展
CONSOLE_USER=$(stat -f %Su /dev/console 2>/dev/null || echo "")
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  CONSOLE_USER=$(ls -d /Users/*/Library 2>/dev/null | head -1 | sed 's|/Users/||;s|/Library||')
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REG_SCRIPT="$SCRIPT_DIR/install_extension.sh"

if [ -n "$CONSOLE_USER" ] && [ -f "$REG_SCRIPT" ]; then
  TMP_SCRIPT="/tmp/qd-install-extension-$(date +%s).sh"
  cp "$REG_SCRIPT" "$TMP_SCRIPT" 2>/dev/null
  chmod 755 "$TMP_SCRIPT" 2>/dev/null
  if [ -f "$TMP_SCRIPT" ]; then
    echo "==> 为 $CONSOLE_USER 注册浏览器扩展"
    USER_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || echo "")
    if [ -n "$USER_UID" ] && command -v launchctl >/dev/null 2>&1 && [ "$(id -u)" = "0" ]; then
      launchctl asuser "$USER_UID" bash "$TMP_SCRIPT" 2>&1 || \
      su - "$CONSOLE_USER" -c "bash '$TMP_SCRIPT'" 2>&1 || \
      bash "$TMP_SCRIPT" 2>&1
    else
      su - "$CONSOLE_USER" -c "bash '$TMP_SCRIPT'" 2>&1 || bash "$TMP_SCRIPT" 2>&1
    fi
    rm -f "$TMP_SCRIPT"
  fi
fi

# 4. 提示使用应用内向导
if [ -d "$APP" ]; then
  echo "==> 安装完成！打开速下 → 设置 → 浏览器扩展 → 一键安装向导"
fi

exit 0
